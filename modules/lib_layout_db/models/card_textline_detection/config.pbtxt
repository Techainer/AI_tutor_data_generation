name: "card_textline_detection"
platform: "onnxruntime_onnx"
default_model_filename: "optimized_model_20240624.onnx"
input: [
    {
        name: "x"
        data_type: TYPE_FP32
        dims: [ -1, 3, -1, -1 ]
    }
]
output: [
    {
        name: "sigmoid_121.tmp_0"
        data_type: TYPE_FP32
        dims: [ -1, 1, -1, -1 ]
    }
]
instance_group: [
    {
        kind: KIND_GPU
        count: 3
    }
]

model_warmup: [
    {
        name: "random_input"
        inputs: {
            key: "x"
            value: {
                data_type: TYPE_FP32
                dims: [ 1, 3, 960, 960 ]
                random_data: true
            }
        }
    }
]
