name: "card_ocr_vietocr"
platform: "pytorch_libtorch"
default_model_filename: "scripted_resnet50_transformer_vn_fix_name_address_17-6.pt"
input [
    {
        name: "INPUT__0"
        data_type: TYPE_FP32
        dims: [ -1, 3, 48, -1 ]
    }
]
output [
    {
        name: "OUTPUT__0"
        data_type: TYPE_INT64
        dims: [ -1, -1 ]
    },
    {
        name: "OUTPUT__1"
        data_type: TYPE_FP32
        dims: [ -1, -1 ]
    }
]
dynamic_batching {
    max_queue_delay_microseconds: 100000
}
model_warmup: [
    {
        name: "random_input"
        inputs: {
            key: "INPUT__0"
            value: {
                data_type: TYPE_FP32
                dims: [ 1, 3, 48, 64 ]
                random_data: true
            }
        }
    },
    {
        name: "random_input"
        inputs: {
            key: "INPUT__0"
            value: {
                data_type: TYPE_FP32
                dims: [ 1, 3, 48, 332 ]
                random_data: true
            }
        }
    }
]
instance_group: [
    {
        kind: KIND_GPU
        count: 8
    }
]

parameters: {
key: "DISABLE_OPTIMIZED_EXECUTION"
    value: {
    string_value: "true"
    }
}